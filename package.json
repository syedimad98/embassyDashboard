{
  "name": "embassy-reporting-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend --config frontend/vite.config.js",
    "server": "node backend/server/index.js",
    "dev:full": "concurrently -k \"npm:server\" \"npm:dev\"",
    "build": "vite build frontend --config frontend/vite.config.js",
    "seed:reports": "node backend/server/seedReports.js",
    "admin:promote": "node backend/server/promoteAdmin.js",
    "lint": "oxlint",
    "test": "node --test backend/server/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
