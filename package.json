{
  "name": "embassy-reporting-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "server": "node backend/server/index.js",
    "dev:full": "concurrently -k \"npm:server\" \"npm:dev\"",
    "build": "npm --prefix frontend run build",
    "seed:reports": "node backend/server/seedReports.js",
    "admin:promote": "node backend/server/promoteAdmin.js",
    "lint": "oxlint",
    "test": "node --test backend/server/*.test.js",
    "preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0"
  }
}
